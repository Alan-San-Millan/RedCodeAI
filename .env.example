# Clave gratuita de la API de Gemini. Consiguela en https://aistudio.google.com/apikey
# Las claves de Google AI Studio empiezan con "AIza".
GEMINI_API_KEY=

# Modelo a utilizar. gemini-3.6-flash es el que respondio de forma estable en las
# pruebas end-to-end de este proyecto con salida estructurada (responseSchema).
# Alternativas en capa gratuita: gemini-3.7-flash, gemini-3.5-flash, gemini-3.5-flash-lite
# (a veces devuelven 503 "high demand" con responseSchema; suele ser temporal).
# gemini-2.5-flash ya no esta disponible para API keys nuevas.
# gemini-1.5-flash y gemini-2.0-flash estan retirados y ya no responden.
GEMINI_MODEL=gemini-3.6-flash

# Temperature por defecto del generador de codigo.
# Baja a proposito: buscamos codigo consistente y reproducible.
# Se puede ajustar desde la interfaz sin reiniciar el servidor.
GEMINI_TEMPERATURE=0.2

# Milisegundos antes de cancelar una solicitud que no responde.
GEMINI_TIMEOUT_MS=90000

# Puerto del servidor web local.
PORT=3000
